# Caminho do CSV gravado pela placa ou pelo mock (relativo à pasta web/)
DAILY_REPORT_PATH=../daily-report.csv

# Login (Better Auth). Segredo com 32+ caracteres, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Opcional: arquivo do banco de login (padrão .data/auth.sqlite, relativo à pasta web/)
# AUTH_SQLITE_PATH=.data/auth.sqlite

# Alertas por e-mail (Gmail com senha de app). Sem isso, o app funciona e só não envia e-mail.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_FROM_EMAIL=GasGuard <seu-email@gmail.com>
